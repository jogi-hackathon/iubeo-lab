# Deployment configuration for the public vc demo (see deploy/README.md).
# Sourced by deploy/install.sh. Edit the hosts, then run: sudo deploy/install.sh

# Public hostnames. Both must resolve to this host with the Cloudflare proxy
# OFF (DNS only): WebTransport needs UDP reachability and ACME needs HTTP-01.
VC_HOST=vc.thirdlf03.com
MEDIA_HOST=media.thirdlf03.com

# UDP port the moq WebTransport relay listens on.
WT_PORT=4443

# ACME account email. Leave empty to register without one (renewal is automatic
# either way, but an address gets expiry warnings).
ACME_EMAIL=

# Pinned toolchain versions downloaded by install.sh.
OTP_URL=https://github.com/erlef/otp_builds/releases/download/maint-latest/otp-x86_64-unknown-linux-gnu-ubuntu-24.04.tar.gz
ELIXIR_VERSION=1.20.4
ELIXIR_OTP=29
NODE_VERSION=24.21.0
MOQ_RELAY_VERSION=0.17.1
# The bench rig was verified against moq-lite-06; newer revisions negotiate
# other drafts, so pin the relay to the tested one.
MOQ_LISTEN_VERSION=moq-lite-06
